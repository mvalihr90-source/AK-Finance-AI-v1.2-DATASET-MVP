<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/title" android:text="AK Finance AI"
            android:textSize="28sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/status" android:layout_marginTop="8dp"
            android:text="وضعیت پیامک: نیازمند دسترسی" android:textSize="16sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/permissionButton" android:layout_marginTop="16dp"
            android:text="فعال‌سازی دسترسی پیامک"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/count" android:layout_marginTop="20dp"
            android:text="پیام‌های ثبت‌شده: 0" android:textSize="18sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/pendingTitle" android:layout_marginTop="24dp"
            android:text="آخرین پیام نیازمند بررسی" android:textStyle="bold" android:textSize="20sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/pendingMessage" android:layout_marginTop="8dp"
            android:text="هنوز پیامی برای بررسی وجود ندارد." android:textSize="16sp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/pendingMeta" android:layout_marginTop="8dp"
            android:text="" android:textSize="15sp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/confirmButton" android:layout_marginTop="12dp"
            android:text="تأیید تشخیص" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/nonBankButton"
            android:text="این پیام بانکی نیست" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/correctTransactionButton"
            android:text="این پیام تراکنش بانکی است" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/transactionsTitle" android:layout_marginTop="28dp"
            android:text="تراکنش‌های قطعی" android:textStyle="bold" android:textSize="20sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/transactions" android:layout_marginTop="8dp"
            android:text="هنوز تراکنشی ثبت نشده است." android:textSize="16sp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
